# the installer is attached to the release, not committed
release-assets/*.exe
release-assets/*.deb
release-assets/*.tar.gz
release-assets/*.dmg

# --- secrets and credentials: never commit these (keys, tokens, passwords, certificates, private keys) ---
.env
.env.*
!.env.example
*.env.txt
PENQWIN_SECRETS*
OLLAMA_API_KEY*
*API*Key*.txt
*api*key*.txt
UPDATE_SIGNING*
client_secret*.json
credentials*.json
service-account*.json
*.key
*.pem
*.pfx
*.p12
*.jks
*.keystore
id_rsa*
id_ed25519*
ssh-key*
*.token
*.secret
*.secrets
